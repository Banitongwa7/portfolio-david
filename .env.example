# Copy to .env.local for local development, and set the same names in
# Vercel → Settings → Environment Variables. Never put real values here.

# Gmail account that sends and receives the contact form (app/api/mail).
# PASSWORD is a Gmail app password, not the account password.
EMAIL=
PASSWORD=

# Host of the deployed PartyKit poll server (Live Poll tool), without the
# protocol, e.g. portfolio-polls.<your-partykit-user>.partykit.dev.
# Deploy it with `npx partykit deploy`. Read at build time: redeploy the site
# after changing it. Leave empty locally to use `npx partykit dev`.
NEXT_PUBLIC_PARTYKIT_HOST=

# Microsoft Clarity project ID. Clarity only starts when this is set and the
# visitor accepted analytics in the cookie banner.
NEXT_PUBLIC_CLARITY_ID=
